#include <windows.h>

101 ICON "@MH_SHARED_SOURCE_DIR@/assets/motorhead.ico"
102 BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/motorhead_banner.bmp"
103 RCDATA "@MH_SHARED_SOURCE_DIR@/assets/Default.LGF"
// The reconstructed game executable is carried inside this single-file setup.
104 RCDATA "@MOTORHEAD_BINARY@"
// Includes reconstruction-owned defaults such as SkipIntroMovies.
105 RCDATA "@MH_SHARED_SOURCE_DIR@/assets/motorhead.cfg"
// Reconstruction-owned six-stop Options dial and Gameplay Options animation.
106 RCDATA "@MH_SHARED_SOURCE_DIR@/assets/MenuDial.spr"
107 RCDATA "@MOTORHEAD_LINUX_BINARY@"
108 RCDATA "@MOTORHEAD_LINUX_SOURCE@/assets/Launch-Motorhead.sh"
109 RCDATA "@MOTORHEAD_LINUX_SOURCE@/assets/README-STEAMDECK.txt"
1 RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/assets/installer.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Motorhead\0"
      VALUE "FileDescription", "Motorhead Setup\0"
      VALUE "FileVersion", "1.0.0\0"
      VALUE "InternalName", "Installer\0"
      VALUE "OriginalFilename", "Installer.exe\0"
      VALUE "ProductName", "Motorhead\0"
      VALUE "ProductVersion", "1.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
