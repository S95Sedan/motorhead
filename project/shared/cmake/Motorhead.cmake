set(MH_PLATFORM_ROOT "${PROJECT_SOURCE_DIR}")
set(MH_SYSTEM_ROOT "${MH_PLATFORM_ROOT}")
# A Windows-hosted OpenGL diagnostic still uses the host socket/file ABI.
if(MH_LINUX_VARIANT AND WIN32)
  set(MH_SYSTEM_ROOT "${PROJECT_SOURCE_DIR}/../motorhead-windows")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/host-include/platform")
  configure_file("${MH_SYSTEM_ROOT}/include/platform/native_socket.hpp"
                 "${CMAKE_BINARY_DIR}/host-include/platform/native_socket.hpp" COPYONLY)
  add_compile_definitions(NOMINMAX)
endif()
get_filename_component(MH_SHARED_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
option(MH_WARNINGS_AS_ERRORS "Treat project warnings as errors" ON)
option(MH_BUILD_PLATFORM_CHECKS "Build platform verification executable" OFF)
include("${MH_SHARED_ROOT}/cmake/ProjectWarnings.cmake")
set(MH_INCLUDE_DIR "${MH_SHARED_ROOT}/include")
include_directories(BEFORE "${MH_PLATFORM_ROOT}/include" "${MH_INCLUDE_DIR}")
if(MH_LINUX_VARIANT AND WIN32)
  include_directories(BEFORE "${CMAKE_BINARY_DIR}/host-include")
endif()
if(NOT MH_LINUX_VARIANT)
  add_compile_definitions(MH_WINDOWS_XP_COMPAT=1 NOMINMAX)
  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
  if(MINGW AND CMAKE_SIZEOF_VOID_P EQUAL 4)
    add_compile_options(-msse2 -mfpmath=sse)
  endif()
else()
  set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE OFF)
endif()
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
foreach(feature TEST_LIBRARY TESTS EXAMPLES INSTALL WASAPI CAMERA SENSOR DIALOG TRAY GPU RENDER_GPU VULKAN RENDER_VULKAN)
  set(SDL_${feature} OFF CACHE BOOL "" FORCE)
endforeach()
foreach(feature MMDEVICEAPI_H ROAPI_H SENSORSAPI_H SHELLSCALINGAPI_H WINDOWS_GAMING_INPUT_H GAMEINPUT_H)
  set(HAVE_${feature} OFF CACHE INTERNAL "" FORCE)
endforeach()
add_subdirectory("${MH_SHARED_ROOT}/third_party/sdl" third_party/sdl-build EXCLUDE_FROM_ALL)
add_subdirectory("${MH_SHARED_ROOT}/src" shared)
install(TARGETS Motorhead RUNTIME DESTINATION .)
